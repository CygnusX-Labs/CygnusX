                           <pdfaProperty:name>LicensorURL</pdfaProperty:name>
                           <pdfaProperty:valueType>URL</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>Iptc4xmpCore</pdfaSchema:prefix>
                  <pdfaSchema:schema>IPTC Core</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Code of the country the content is focussing on -- either the country shown in visual media or referenced in text or audio media. This element is at the top/first level of a top-down geographical hierarchy. The code should be taken from ISO 3166 two or three letter code. The full name of a country should go to the "Country" element.</pdfaProperty:description>
                           <pdfaProperty:name>CountryCode</pdfaProperty:name>
                           <pdfaProperty:valueType>Closed Choice of Text</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
               </rdf:li>
