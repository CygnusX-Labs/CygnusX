                  <pdfaSchema:namespaceURI>http://ns.adobe.com/xap/1.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>xmp</pdfaSchema:prefix>
                  <pdfaSchema:schema>XMP Basic</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>The date and time the resource was originally created.</pdfaProperty:description>
                           <pdfaProperty:name>Rating</pdfaProperty:name>
                           <pdfaProperty:valueType>Closed Choice of Integer</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>A word or short phrase that identifies a document as a member of a user-defined collection. Used to organize documents in a file browser.</pdfaProperty:description>
                           <pdfaProperty:name>Label</pdfaProperty:name>
                           <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
               </rdf:li>
