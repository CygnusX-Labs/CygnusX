                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>"Red Hue" setting. Range -100 to 100.</pdfaProperty:description>
                           <pdfaProperty:name>RedHue</pdfaProperty:name>
                           <pdfaProperty:valueType>Integer</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>"Red Saturation" setting. Range -100 to 100.</pdfaProperty:description>
