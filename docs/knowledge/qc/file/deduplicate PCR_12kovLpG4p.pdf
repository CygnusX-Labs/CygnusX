                  <pdfaSchema:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>plus</pdfaSchema:prefix>
                  <pdfaSchema:schema>PLUS LDF Version 1.2.0</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
