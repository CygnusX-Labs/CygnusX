                           <pdfaProperty:valueType>Integer</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>The name of the Tone Curve described by ToneCurve. One of: Linear; Medium Contrast; Strong Contrast; Custom or a user-defined preset name</pdfaProperty:description>
