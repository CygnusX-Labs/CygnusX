{
  "$defs": {
    "ClaimProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cygnusx.claim_provenance.v1",
          "default": "cygnusx.claim_provenance.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "const": "DEG_TABLE_CELL",
          "default": "DEG_TABLE_CELL",
          "title": "Claim Type",
          "type": "string"
        },
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "claim_text_verified": {
          "const": false,
          "default": false,
          "title": "Claim Text Verified",
          "type": "boolean"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "source_report_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Report Id"
        },
        "report_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Version"
        },
        "report_snapshot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Snapshot Id"
        },
        "snapshot_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Digest"
        },
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "result_observation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Observation Id"
        },
        "observation_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Digest"
        },
        "observation_binding": {
          "enum": [
            "VERIFIED_ASSOCIATION",
            "NOT_RECORDED"
          ],
          "title": "Observation Binding",
          "type": "string"
        },
        "file_record_id": {
          "format": "uuid",
          "title": "File Record Id",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "table_identifier": {
          "const": "deg.tsv",
          "default": "deg.tsv",
          "title": "Table Identifier",
          "type": "string"
        },
        "row_identifier": {
          "title": "Row Identifier",
          "type": "string"
        },
        "row_number": {
          "title": "Row Number",
          "type": "integer"
        },
        "column_identifier": {
          "title": "Column Identifier",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "transformation": {
          "const": "identity",
          "default": "identity",
          "title": "Transformation",
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "VERIFIED_VALUE",
            "NOT_VERIFIED"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "supported_statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supported Statement"
        },
        "supported_statement_status": {
          "enum": [
            "SUPPORTED_CLAIM",
            "NOT_VERIFIED"
          ],
          "title": "Supported Statement Status",
          "type": "string"
        },
        "interpretation_status": {
          "anyOf": [
            {
              "const": "AI_INTERPRETATION",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interpretation Status"
        },
        "dataset_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Version Id"
        },
        "analysis_link_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Link Id"
        },
        "definition_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Definition Digest"
        },
        "execution_binding_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Binding Digest"
        },
        "definition_status": {
          "enum": [
            "VERIFIED_DOCUMENT",
            "REFERENCE_ONLY",
            "NOT_RECORDED"
          ],
          "title": "Definition Status",
          "type": "string"
        },
        "input_file_record_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Input File Record Ids",
          "type": "array"
        },
        "missing_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "verification_scope": {
          "const": "current_cell_bytes_not_claim_truth_or_historical_execution",
          "default": "current_cell_bytes_not_claim_truth_or_historical_execution",
          "title": "Verification Scope",
          "type": "string"
        },
        "reproducibility_status": {
          "const": "NOT_RUN",
          "default": "NOT_RUN",
          "title": "Reproducibility Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "project_id",
        "source_report_id",
        "report_version",
        "report_snapshot_id",
        "snapshot_digest",
        "task_id",
        "result_observation_id",
        "observation_digest",
        "observation_binding",
        "file_record_id",
        "file_sha256",
        "row_identifier",
        "row_number",
        "column_identifier",
        "value",
        "verification_status",
        "supported_statement",
        "supported_statement_status",
        "interpretation_status",
        "dataset_version_id",
        "analysis_link_id",
        "definition_digest",
        "execution_binding_digest",
        "definition_status"
      ],
      "title": "ClaimProvenance",
      "type": "object"
    },
    "DeliveryFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[A-Za-z0-9_./-]{1,240}$",
          "title": "Path",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "report_file",
            "file_record",
            "report_snapshot",
            "instructions",
            "verifier"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source_kind",
        "size",
        "sha256"
      ],
      "title": "DeliveryFile",
      "type": "object"
    },
    "DeliveryReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "project",
            "dataset_version",
            "file_record",
            "task",
            "run",
            "result_observation",
            "report",
            "report_snapshot",
            "evidence_manifest",
            "historical_association"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "status": {
          "default": "VERIFIED_ASSOCIATION",
          "enum": [
            "VERIFIED_ASSOCIATION",
            "PARTIAL_ASSOCIATION",
            "NOT_RECORDED",
            "UNAVAILABLE",
            "ACCESS_DENIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "disposition": {
          "default": "reference_only",
          "enum": [
            "reference_only",
            "missing",
            "unverified",
            "excluded"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "result_observation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Observation Id"
        },
        "parent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "dataset_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version Id"
        },
        "analysis_link_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Link Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DeliveryReference",
      "type": "object"
    },
    "ExportSelection": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "evidence",
          "enum": [
            "evidence",
            "results",
            "reproduction_materials"
          ],
          "title": "Kind",
          "type": "string"
        },
        "task_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Task Ids",
          "type": "array"
        },
        "report_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Report Ids",
          "type": "array"
        }
      },
      "title": "ExportSelection",
      "type": "object"
    },
    "FrozenProjectClaims": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cygnusx.project_verified_claim_selection.v1",
          "default": "cygnusx.project_verified_claim_selection.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimProvenance"
          },
          "title": "Claims",
          "type": "array"
        }
      },
      "title": "FrozenProjectClaims",
      "type": "object"
    },
    "ProjectDeliveryManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cygnusx.project_delivery.v1",
          "default": "cygnusx.project_delivery.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "digest_policy": {
          "const": "sorted_utf8_json.v1",
          "default": "sorted_utf8_json.v1",
          "title": "Digest Policy",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ExportSelection"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeliveryFile"
          },
          "maxItems": 1000,
          "title": "Files",
          "type": "array"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DeliveryReference"
          },
          "maxItems": 4000,
          "title": "References",
          "type": "array"
        },
        "gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "evidence_status": {
          "default": "partial",
          "enum": [
            "partial",
            "complete"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "reproduction_status": {
          "const": "NOT_RUN",
          "default": "NOT_RUN",
          "title": "Reproduction Status",
          "type": "string"
        },
        "association_scope": {
          "const": "explicit_dataset_links_only",
          "default": "explicit_dataset_links_only",
          "title": "Association Scope",
          "type": "string"
        },
        "redaction_policy": {
          "const": "project_delivery_allowlist.v1",
          "default": "project_delivery_allowlist.v1",
          "title": "Redaction Policy",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "owner_id",
        "selection"
      ],
      "title": "ProjectDeliveryManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cygnusx.project_report_source.v1",
      "default": "cygnusx.project_report_source.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "const": "project",
      "default": "project",
      "title": "Source Kind",
      "type": "string"
    },
    "report_type": {
      "const": "project_scientific_summary",
      "default": "project_scientific_summary",
      "title": "Report Type",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "source_manifest_job_id": {
      "format": "uuid",
      "title": "Source Manifest Job Id",
      "type": "string"
    },
    "source_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Digest",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/ProjectDeliveryManifest"
    },
    "selection": {
      "$ref": "#/$defs/FrozenProjectClaims"
    },
    "selection_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Digest",
      "type": "string"
    },
    "format": {
      "enum": [
        "html",
        "html_pdf"
      ],
      "title": "Format",
      "type": "string"
    },
    "template_version": {
      "const": "project-summary.v1",
      "default": "project-summary.v1",
      "title": "Template Version",
      "type": "string"
    },
    "renderer_version": {
      "const": "project-summary-adapter.v1",
      "default": "project-summary-adapter.v1",
      "title": "Renderer Version",
      "type": "string"
    },
    "renderer_runtime": {
      "const": "NOT_OBSERVED",
      "default": "NOT_OBSERVED",
      "title": "Renderer Runtime",
      "type": "string"
    },
    "redaction_policy_version": {
      "const": "project-report-allowlist.v1",
      "default": "project-report-allowlist.v1",
      "title": "Redaction Policy Version",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "project_id",
    "source_manifest_job_id",
    "source_manifest_digest",
    "manifest",
    "selection",
    "selection_digest",
    "format"
  ],
  "title": "ProjectReportSource",
  "type": "object"
}
