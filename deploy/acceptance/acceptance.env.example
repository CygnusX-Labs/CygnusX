# Copy outside repository, chmod 600; no shell expansion or root .env.
# App/frontend: source SHA tag or digest; infrastructure/browser: digest required.
ACCEPTANCE_APP_IMAGE=REQUIRED
ACCEPTANCE_FRONTEND_IMAGE=REQUIRED
ACCEPTANCE_POSTGRES_IMAGE=REQUIRED
ACCEPTANCE_REDIS_IMAGE=REQUIRED
# Linux image with matching playwright package AND installed Chromium.
ACCEPTANCE_BROWSER_IMAGE=REQUIRED
# Generate independent secrets.token_hex(32) values, never production credentials.
ACCEPTANCE_DB_PASSWORD=REQUIRED
ACCEPTANCE_REDIS_PASSWORD=REQUIRED
ACCEPTANCE_APP_SECRET=REQUIRED
ACCEPTANCE_JWT_SECRET=REQUIRED
ACCEPTANCE_READS=false
ACCEPTANCE_WRITES=false
ACCEPTANCE_PDF=false
# Absolute host path to this repository's reviewed browser seccomp profile.
ACCEPTANCE_BROWSER_SECCOMP=/absolute/path/to/repo/deploy/acceptance/seccomp-browser.json
