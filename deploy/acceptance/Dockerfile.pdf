# RI09.5 PDF acceptance image: extends the reviewed app/worker base with the
# exact renderer chain required by BioReportAdapter -> report_audit_pdf_renderer
# (Pandoc HTML -> Typst). No business code, no analysis tooling.
#
# Build context is the repository root. The base image is reviewed and pinned by
# tag+digest; the renderer pins are recorded in the build log and versions probe.
ARG ACCEPTANCE_BASE_IMAGE
FROM ${ACCEPTANCE_BASE_IMAGE}

# Pinned Typst release (Debian trixie has no typst package). musl static binary.
ARG TYPST_VERSION=0.13.1
ARG TYPST_SHA256=7d214bfeffc2e585dc422d1a09d2b144969421281e8c7f5d784b65fc69b5673f

# 国内加速：继承基础镜像 apt 源（ustc），此处不重复换源。
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        pandoc \
        fontconfig \
        fonts-droid-fallback \
        fonts-noto-cjk \
        ca-certificates \
        curl \
        xz-utils; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL -o /tmp/typst.tar.xz \
      "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz"; \
    echo "${TYPST_SHA256}  /tmp/typst.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/typst.tar.xz -C /tmp; \
    install -m 0755 "/tmp/typst-x86_64-unknown-linux-musl/typst" /usr/local/bin/typst; \
    rm -rf /tmp/typst.tar.xz /tmp/typst-x86_64-unknown-linux-musl

RUN fc-cache -f >/dev/null 2>&1 || true

# Acceptance overlay: current data/ plus the UID 10001 private volume seed.
WORKDIR /app
COPY --chown=10001:10001 data/ /app/data/
COPY --chown=10001:10001 deploy/acceptance/private-storage/ /acceptance-storage/
USER 10001:10001
