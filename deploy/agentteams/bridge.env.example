# Never put OmicHub database, Redis, Docker, or storage credentials here.
BRIDGE_ENVIRONMENT=production
BRIDGE_OMICHUB_BASE_URL=https://omic-hub-api.internal
# Configure exactly one upstream credential. An API Key belongs to the dedicated,
# least-privileged OmicHub integration user and is sent as X-API-Key.
BRIDGE_OMICHUB_SERVICE_TOKEN=replace-with-restricted-service-user-token
# BRIDGE_OMICHUB_API_KEY=omh_replace-with-restricted-integration-user-key
BRIDGE_APPROVAL_SIGNING_SECRET=replace-with-32-byte-random-secret
BRIDGE_IDENTITIES=approval-authority:replace-human-approval-gateway,bioops-manager:replace-manager,data-steward:replace-steward,workflow-operator:replace-operator,quality-auditor:replace-auditor,delivery-reporter:replace-reporter
BRIDGE_ALLOWED_FLOW_IDS=rna_seq
BRIDGE_MAX_REQUEST_BYTES=1048576
BRIDGE_MAX_RESPONSE_BYTES=1048576
BRIDGE_AUDIT_LOG_PATH=/var/lib/omichub-agentteams-bridge/audit.jsonl
BRIDGE_CASE_STORE_PATH=/var/lib/omichub-agentteams-bridge/cases.json
BRIDGE_MANIFEST_DIR=/var/lib/omichub-agentteams-bridge/manifests
