# ============================================
# OmicHub 环境变量配置模板
# 复制为 .env 并修改对应值
# ============================================

# ===== 应用配置 =====
APP_NAME=OmicHub
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# ===== 首次部署管理员初始化 =====
# 生产环境必须设置强密码；开发环境留空则使用默认弱密码并打印警告
OMICHBUB_INIT_ADMIN_USERNAME=admin
OMICHBUB_INIT_ADMIN_EMAIL=admin@example.com
OMICHBUB_INIT_ADMIN_PASSWORD=

# ===== 数据库配置 =====
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=omichub
POSTGRES_PASSWORD=omichub_dev_password
POSTGRES_DB=omichub
DATABASE_URL=postgresql+asyncpg://omichub:omichub_dev_password@db:5432/omichub

# ===== Redis 配置 =====
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CELERY_BROKER_URL=redis://cache:6379/1
CELERY_RESULT_BACKEND=redis://cache:6379/2

# ===== JWT 配置 =====
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS 配置 =====
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== AI 配置 =====
# 方式 1（推荐）：使用外置 YAML 管理多 Provider，参见 data/ai_providers.yaml.example
# 方式 2：保留旧的单 Provider 兜底（仅当数据库中无 Provider 时生效）
AI_PROVIDER_CONFIG_YAML=data/ai_providers.yaml
# YAML 中可通过 ${ENV_VAR} 引用此处定义的密钥，密钥留在 .env、Provider 列表留在 YAML：
# AL_API_KEY=<your-aliyun-dashscope-api-key>

# ===== 文件存储 =====
STORAGE_TYPE=local
STORAGE_PATH=/data/omichub
UPLOAD_DIR=uploads
RESULTS_DIR=results

# ===== Snakemake 配置 =====
SNAKEMAKE_CORES=4
SNAKEMAKE_USE_CONDA=true
SNAKEMAKE_CONDA_PREFIX=/opt/conda/envs

# ===== Docker Compose 配置 =====
COMPOSE_PROJECT_NAME=omichub
