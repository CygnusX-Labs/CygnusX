-
-        size_mb = os.path.getsize(file_path) / (1024 * 1024)
-        if size_mb > self.max_file_size_mb:
-            logger.warning(
-                "PDF file size %.2f MB exceeds limit %d MB: %s",
-                size_mb,
-                self.max_file_size_mb,
-                file_path,
-            )
-            return False, "file_size_exceeded"
