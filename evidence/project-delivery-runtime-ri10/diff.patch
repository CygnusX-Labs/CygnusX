-        score = 0.0
-        
-        # 引擎排名分数（0-10）
-        positions = item.get("positions", [])
-        if positions:
-            avg_position = sum(positions) / len(positions)
-            score += max(0, 10 - avg_position)
-        
-        # 多引擎共识（0-5）
-        engines = item.get("engines", [])
-        score += min(len(engines) * 0.5, 5)
-        
-        # 内容质量（0-3）
-        content = item.get("content", "")
-        if len(content) > 100:
-            score += 3
-        elif len(content) > 50:
-            score += 2
-        elif len(content) > 0:
-            score += 1
-        
-        return score
