+            raise NotFoundError("Run 不存在")
+        link_id = run.plan_json.get("dataset_analysis_link_id")
+        if link_id is None:
+            return None
+        link = await self._db.get(DatasetAnalysisLinkModel, UUID(link_id))
+        if link is None or link.normalized_request.get("owner_id") != str(owner):
+            raise ConflictError("Dataset Run 关联不可用")
+        return link
