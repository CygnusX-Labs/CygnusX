+"""Real Task/Run SQLite transaction; queue and Flow validation are offline doubles."""
+
+from __future__ import annotations
+
+from unittest.mock import AsyncMock
+from uuid import uuid4
+
+import pytest
+from sqlalchemy import event, func, select
+
+from cygnusx.application.schemas.task import TaskSubmitRequest
+from cygnusx.core.exceptions import ConflictError
+from cygnusx.domain.flow.submission_validator import FlowSubmissionValidator, ValidationResult
+from cygnusx.infrastructure.database.models.run import RunModel
+from cygnusx.infrastructure.database.models.run_event import RunEventModel
+from cygnusx.infrastructure.database.models.task import TaskModel
+from tests.unit.test_dataset_phase3 import registry as registry
+from tests.unit.test_execution_evidence_ri13 import execution_env as execution_env
+
+pytestmark = [pytest.mark.unit, pytest.mark.asyncio]
+
+
+@pytest.mark.parametrize("fail_before_commit", [False, True])
+async def test_run_task_and_event_share_commit_before_queue(
+    execution_env, monkeypatch, fail_before_commit
+):
+    from cygnusx.application.services import file_service, task_service
+
+    env = execution_env
+    for model in (RunModel, RunEventModel):
+        model.__table__.create(env.db.sync.bind)
+    run_id = uuid4()
+    request = TaskSubmitRequest(
+        flow_id="rna_seq",
+        name="atomic",
+        parameters={"cores": 1},
+        comparisons=[],
+        idempotency_key=f"run:{run_id}",
+    )
+    run = RunModel(
+        id=run_id,
+        user_id=env.owner,
+        project_slug="owned",
+        flow_id="rna_seq",
+        release_id="test",
+        request_key="atomic-test",
+        plan_digest="0" * 64,
+        plan_json=request.model_dump(mode="json"),
+        status="plan_pending",
+    )
+    env.db.add(run)
+    await env.db.commit()
+    monkeypatch.setattr(
+        FlowSubmissionValidator,
+        "validate",
+        AsyncMock(
+            return_value=ValidationResult(
+                valid=True, errors=[], warnings=[], normalized_request=request
+            )
+        ),
+    )
+    monkeypatch.setattr(file_service, "ensure_directory_chain", AsyncMock())
+    settings = task_service.get_settings().model_copy(update={"enable_cookie_system": False})
+    monkeypatch.setattr(task_service, "get_settings", lambda: settings)
+    service = task_service.TaskService(env.db)
+    monkeypatch.setattr(service, "_make_work_dir", lambda *a: env.task.work_dir)
+    monkeypatch.setattr(service, "_write_monitor_config", lambda **k: None)
+    queued, commits = [], []
+
+    def before_commit(session):
+        session.flush()
+        persisted = session.get(RunModel, run_id)
+        assert persisted.task_id is not None
+        task = session.get(TaskModel, persisted.task_id)
+        assert task is not None and task.status == "queued"
+        assert session.scalar(select(func.count()).select_from(RunEventModel)) == 1
+        commits.append(str(task.id))
+        if fail_before_commit:
+            raise RuntimeError("controlled commit failure")
+
+    def enqueue(*args, **kwargs):
+        assert commits == [args[2]]
+        assert str(env.db.sync.get(RunModel, run_id).task_id) == args[2]
+        queued.append(args[2])
+
+    event.listen(env.db.sync, "before_commit", before_commit)
+    monkeypatch.setattr(task_service, "enqueue_task", enqueue)
+    try:
+        with pytest.raises(ConflictError, match="审批入口"):
+            await service.submit(str(env.owner), request)
+        assert env.db.sync.scalar(select(func.count()).select_from(TaskModel)) == 0
+        if fail_before_commit:
+            with pytest.raises(RuntimeError, match="controlled commit failure"):
+                await service.submit(str(env.owner), request, run_id=run_id)
+            await env.db.rollback()
+            assert env.db.sync.get(RunModel, run_id).task_id is None
+            assert env.db.sync.scalar(select(func.count()).select_from(TaskModel)) == 0
+            assert env.db.sync.scalar(select(func.count()).select_from(RunEventModel)) == 0
+            assert queued == []
+        else:
+            result = await service.submit(str(env.owner), request, run_id=run_id)
+            event.remove(env.db.sync, "before_commit", before_commit)
+            repeated = await service.submit(str(env.owner), request, run_id=run_id)
+            assert repeated.id == result.id and queued == [str(result.id)]
+            run = env.db.sync.get(RunModel, run_id)
+            run.task_id, run.status = None, "plan_pending"
+            await env.db.commit()
+            with pytest.raises(ConflictError, match="人工对账"):
+                await service.submit(str(env.owner), request, run_id=run_id)
+            assert env.db.sync.get(RunModel, run_id).task_id is None
+            assert queued == [str(result.id)]
+            with pytest.raises(ConflictError, match="幂等身份"):
+                await service.submit(
+                    str(env.owner),
+                    request.model_copy(update={"idempotency_key": f"run:{uuid4()}"}),
+                    run_id=run_id,
+                )
+    finally:
+        if event.contains(env.db.sync, "before_commit", before_commit):
+            event.remove(env.db.sync, "before_commit", before_commit)
