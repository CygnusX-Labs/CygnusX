+"""One explicit FASTQ preparation path over the existing Dataset/Run records.
+
+This is metadata preparation only. Human JWT review of assay and groups remains
+separate, frozen worker_paths_verified stays false, and no Task is submitted here.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from uuid import NAMESPACE_URL, UUID, uuid5
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from cygnusx.application.schemas.agent_tools import GatewayResult, SessionFastqPrepareArgs
+from cygnusx.application.schemas.dataset import (
+    AssetAttach,
+    DatasetAnalysisPrepare,
+    DatasetCreate,
+    SampleAttach,
+)
+from cygnusx.application.schemas.tool_invocation import ToolInvocationContext
+from cygnusx.application.services.agent_tool_gateway import digest
+from cygnusx.application.services.dataset_analysis_service import DatasetAnalysisService
+from cygnusx.application.services.dataset_handoff_service import DatasetHandoffService
+from cygnusx.application.services.dataset_import_service import require_dataset_read
+from cygnusx.application.services.dataset_service import DatasetService
+from cygnusx.application.services.research_execution_binding import check_inputs
+from cygnusx.application.services.run_plan_service import RunPlanService
+from cygnusx.core.exceptions import AuthorizationError, ConflictError, ValidationError
+from cygnusx.infrastructure.database.models.agent_tool_invocation import AgentToolInvocationModel
+from cygnusx.infrastructure.database.models.chat import ChatSessionModel
+from cygnusx.infrastructure.database.models.dataset import (
+    DatasetAnalysisLinkModel,
+    DatasetVersionModel,
+)
+
+CAPABILITY = "analysis.prepare_from_session_files"
+
+
+class SessionDatasetPreparationService:
+    def __init__(self, db: AsyncSession) -> None:
+        self.db = db
+        self.datasets = DatasetService(db)
+
+    async def prepare(
+        self, context: ToolInvocationContext, request: SessionFastqPrepareArgs
+    ) -> dict[str, Any]:
+        require_dataset_read()
+        owner = UUID(context.user_id)
+        if not context.extra.get("project_id"):
+            raise ValidationError("需要绑定项目的会话", code="PROJECT_REQUIRED")
+        # Serialize retries on an existing identity; never infer a project from files.
+        session = (
+            await self.db.execute(
+                select(ChatSessionModel)
+                .where(
+                    ChatSessionModel.session_id == context.session_id,
+                    ChatSessionModel.user_id == context.user_id,
+                    ChatSessionModel.status == "active",
+                )
+                .with_for_update()
+                .execution_options(populate_existing=True)
+            )
+        ).scalar_one_or_none()
+        if session is None or session.project_id != context.extra["project_id"]:
+            raise AuthorizationError("会话项目已改变或无权访问", code="FORBIDDEN")
+        project = UUID(session.project_id)
+        for module in ("files", "tasks", "reports", "flows"):
+            await self.datasets.repo.require_module(owner, module)
+        project_row = await self.datasets.repo.project(owner, project)
+        if project_row.status not in {None, "active"}:
+            raise AuthorizationError("当前项目不可准备新分析", code="PROJECT_INACTIVE")
+        keys = [sample.sample_key for sample in request.samples]
+        sample_ids = [sample.sample_id for sample in request.samples]
+        file_ids = [file for sample in request.samples for file in sample.file_record_ids]
+        if (
+            len(set(keys)) != len(keys)
+            or len(set(sample_ids)) != len(sample_ids)
+            or len(set(file_ids)) != len(file_ids)
+        ):
+            raise ValidationError("样本与文件映射必须唯一", code="SAMPLE_FILE_MISMATCH")
+        # Validate every declared reference before creating any lineage metadata.
+        for sample in request.samples:
+            registered = await self.datasets.repo.sample(owner, UUID(sample.sample_id))
+            if set(sample.file_record_ids) != set(registered.file_ids):
+                raise ValidationError("显式文件集合与已登记样本不一致", code="SAMPLE_FILE_MISMATCH")
+            for file in sample.file_record_ids:
+                await self.datasets.repo.file(owner, project, UUID(file))
+        request_digest = digest(request.model_dump(mode="json"))
+        invocation_id = uuid5(
+            NAMESPACE_URL,
+            f"cygnusx:session-fastq:{owner}:{session.session_id}:{request.request_key}",
+        )
+        invocation = await self.db.get(AgentToolInvocationModel, invocation_id)
+        if invocation is not None:
+            if (
+                invocation.project_id != str(project)
+                or invocation.parameters_hash != request_digest
+            ):
+                raise ConflictError("请求键已绑定其他输入或项目", code="REQUEST_KEY_REUSED")
+            dataset_id = UUID(invocation.preview["dataset_id"])
+            version_id = UUID(invocation.preview["dataset_version_id"])
+            version = await self.datasets.repo.version(owner, project, dataset_id, version_id)
+        else:
+            invocation = AgentToolInvocationModel(
+                id=invocation_id,
+                owner_id=str(owner),
+                project_id=str(project),
+                conversation_id=session.session_id,
+                agent_kind=context.extra["agent_kind"],
+                capability_id=CAPABILITY,
+                request_id=request.request_key,
+                parameters_hash=request_digest,
+                status="REVIEW_REQUIRED",
+                preview={},
+            )
+            self.db.add(invocation)
+            dataset = await self.datasets.create(owner, project, DatasetCreate(name=request.name))
+            version = (
+                await self.db.execute(
+                    select(DatasetVersionModel).where(
+                        DatasetVersionModel.dataset_id == dataset.id,
+                        DatasetVersionModel.number == 1,
+                    )
+                )
+            ).scalar_one()
+            dataset_id, version_id = dataset.id, version.id
+            version.source_snapshot = {
+                "session_declaration": {
+                    "session_id": session.session_id,
+                    "invocation_id": str(invocation_id),
+                    "input_type": "raw_fastq",
+                    "declared_assay": "bulk_rnaseq",
+                }
+            }
+            invocation.preview = {
+                "dataset_id": str(dataset_id),
+                "dataset_version_id": str(version_id),
+            }
+            for sample in request.samples:
+                for file in sample.file_record_ids:
+                    await self.datasets.attach_asset(
+                        owner,
+                        project,
+                        dataset_id,
+                        version_id,
+                        AssetAttach(file_record_id=UUID(file), role="raw_reads"),
+                    )
+                await self.datasets.attach_sample(
+                    owner,
+                    project,
+                    dataset_id,
+                    version_id,
+                    SampleAttach(
+                        sample_id=UUID(sample.sample_id),
+                        sample_key=sample.sample_key,
+                        file_record_ids=[UUID(file) for file in sample.file_record_ids],
+                        group=sample.group,
+                        group_confirmed=False,
+                    ),
+                )
+        base = {
+            "mode": "PLAN_ONLY",
+            "project_id": str(project),
+            "dataset_id": str(dataset_id),
+            "dataset_version_id": str(version_id),
+            "write_enabled": False,
+            "gate": "WRITE_GATE_BLOCKED",
+        }
+        if invocation.preview.get("analysis_proposal_id"):
+            link = await self.db.get(
+                DatasetAnalysisLinkModel, UUID(invocation.preview["analysis_proposal_id"])
+            )
+            if link is None or link.version_id != version_id:
+                raise ConflictError("会话预案关联不可用")
+            await check_inputs(self.db, owner, link, require_worker=False)
+            if version.handoff is None:
+                raise ConflictError("会话预案缺少冻结 Handoff")
+            result = {
+                **base,
+                **invocation.preview,
+                "handoff_hash": version.handoff["manifest_hash"],
+                "handoff_frozen": True,
+            }
+        else:
+            handoffs = DatasetHandoffService(self.db)
+            manifest = await handoffs.verify(owner, project, dataset_id, version_id)
+            if any(
+                asset["data_type"] != "RAW_FASTQ" or asset["checksum_status"] != "VERIFIED"
+                for asset in manifest["assets"]
+            ):
+                raise ValidationError(
+                    "试点只接受实测有效的已登记 FASTQ", code="FASTQ_INPUT_REQUIRED"
+                )
+            if not manifest["validation"]["dataset_ready"]:
+                result = {
+                    **base,
+                    "state": "REVIEW_REQUIRED",
+                    "gaps": manifest["validation"]["blocking_reasons"],
+                    "handoff_frozen": False,
+                }
+            else:
+                frozen = await handoffs.manifest(
+                    owner, project, dataset_id, version_id, freeze=True
+                )
+                prepared = await DatasetAnalysisService(
+                    self.db, session_id=session.session_id, invocation_id=invocation_id
+                ).prepare(
+                    owner,
+                    project,
+                    dataset_id,
+                    version_id,
+                    DatasetAnalysisPrepare(
+                        flow_id="rna_seq",
+                        options={
+                            "parameters": {
+                                "Genome_Version": request.parameters.genome_version,
+                                "species": request.parameters.species,
+                                "Library_Types": request.parameters.library_types,
+                                "deg": False,
+                            }
+                        },
+                    ),
+                )
+                if "analysis_proposal_id" not in prepared:
+                    raise ValidationError(
+                        "RNAFlow 预案参数未通过验证", code="ANALYSIS_PREPARE_INVALID"
+                    )
+                link = await self.db.get(
+                    DatasetAnalysisLinkModel, UUID(prepared["analysis_proposal_id"])
+                )
+                assert link is not None
+                run = await RunPlanService(self.db).register_dataset_proposal(
+                    owner, project_row, link
+                )
+                invocation.status = "PREPARED"
+                invocation.confirmation_id = link.confirmation_id
+                invocation.preview = {
+                    **invocation.preview,
+                    "analysis_proposal_id": str(link.id),
+                    "run_id": str(run.id),
+                    "state": "PREPARED",
+                }
+                result = {
+                    **base,
+                    **prepared,
+                    **invocation.preview,
+                    "handoff_hash": frozen["manifest_hash"],
+                    "handoff_frozen": True,
+                }
+        await self.db.flush()
+        return GatewayResult(invocation_id=str(invocation_id), result=result).model_dump()
