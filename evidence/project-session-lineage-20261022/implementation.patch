+    async def register_dataset_proposal(
+        self, owner: UUID, project: ProjectModel, link: DatasetAnalysisLinkModel
+    ) -> RunModel:
+        """Alias an existing Dataset proposal to the existing platform Run shell."""
+        bound = link.normalized_request
+        if (
+            project.user_id != owner
+            or bound.get("owner_id") != str(owner)
+            or bound.get("project_id") != str(project.id)
+        ):
+            raise AuthorizationError("Dataset Run 上下文不匹配")
+        key = f"dataset:{link.id}"
+        plan = {
+            **bound["request"],
+            "dataset_analysis_link_id": str(link.id),
+            "dataset_id": bound["dataset_id"],
+            "dataset_version_id": str(link.version_id),
+            "project_id": str(project.id),
+            "handoff_hash": link.handoff_hash,
+        }
+        digest = hashlib.sha256(
+            json.dumps(plan, sort_keys=True, separators=(",", ":")).encode()
+        ).hexdigest()
+        existing = await self._db.scalar(
+            select(RunModel).where(RunModel.user_id == owner, RunModel.request_key == key)
+        )
+        if existing is not None:
+            if existing.plan_digest != digest:
+                raise ConflictError("Dataset Run 冻结内容变化")
+            return existing
+        run = RunModel(
+            user_id=owner,
+            project_slug=project.slug,
+            flow_id=link.flow_id,
+            release_id=self._flows.get_flow(link.flow_id).meta.version,
+            request_key=key,
+            plan_json=plan,
+            plan_digest=digest,
+            status="plan_pending",
+        )
+        self._db.add(run)
+        await self._db.flush()
+        from cygnusx.application.services.run_event_service import RunEventService
+
+        await RunEventService(self._db).emit(
+            run.id,
+            status="plan_pending",
+            payload={"analysis_link_id": str(link.id), "mode": "PLAN_ONLY"},
+        )
+        return run
+
+    async def dataset_link(self, owner: UUID, run_id: UUID) -> DatasetAnalysisLinkModel | None:
