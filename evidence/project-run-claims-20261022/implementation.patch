+    await db.commit()
+    version = await db.get(DatasetVersionModel, UUID(result["dataset_version_id"]))
+    assert not version.handoff["validation"]["worker_paths_verified"]
+    assert not version.handoff["validation"]["dataset_ready"]
+    assert version.source_snapshot["historical_claim"]["approval_receipt"]["status"] == "CONSUMED"
+    monkeypatch.setattr(analysis_module, "require_agent_write_gate", lambda _: None)
+    settings = analysis_module.get_settings().model_copy(
