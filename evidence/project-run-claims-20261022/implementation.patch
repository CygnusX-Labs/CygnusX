+    req = RunClaimRequest(purpose="Historical references")
+    preview = await service.claim(owner, project, directory.name, req)
+    await service.approve(owner, project, directory.name, UUID(preview["confirmation_id"]))
+    original = DatasetHandoffService.manifest
+
+    async def mutate_after_freeze(*args: Any, **kwargs: Any) -> Any:
+        result = await original(*args, **kwargs)
+        path.write_bytes(b"changed after freeze\n")
+        return result
+
+    monkeypatch.setattr(DatasetHandoffService, "manifest", mutate_after_freeze)
