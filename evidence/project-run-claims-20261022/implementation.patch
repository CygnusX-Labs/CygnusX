+"""Protect retained claim audits against relabeling and table truncation too."""
+
+import sqlalchemy as sa
+from alembic import op
+
+revision = "project_run_claim_audit02"
+down_revision = "project_run_identity01"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.execute("""CREATE OR REPLACE FUNCTION protect_project_run_claim_audit() RETURNS trigger AS $$
+      BEGIN
+        IF TG_OP='DELETE' THEN
+          IF OLD.resource_type='project_run_claim' THEN
+            RAISE EXCEPTION 'project run claim audit is append-only';
+          END IF;
+          RETURN OLD;
+        END IF;
+        IF OLD.resource_type='project_run_claim' OR NEW.resource_type='project_run_claim' THEN
+          RAISE EXCEPTION 'project run claim audit is append-only';
+        END IF;
+        RETURN NEW;
+      END; $$ LANGUAGE plpgsql""")
+    op.execute("""CREATE FUNCTION protect_claim_audit_truncate() RETURNS trigger AS $$
+      BEGIN
+        IF EXISTS(SELECT 1 FROM audit_logs WHERE resource_type='project_run_claim') THEN
+          RAISE EXCEPTION 'project run claim audit is append-only';
+        END IF;
+        RETURN NULL;
+      END; $$ LANGUAGE plpgsql""")
+    op.execute("""CREATE TRIGGER claim_audit_no_truncate BEFORE TRUNCATE ON audit_logs
+                  FOR EACH STATEMENT EXECUTE FUNCTION protect_claim_audit_truncate()""")
+
+
+def downgrade() -> None:
+    if (
+        op.get_bind()
+        .execute(
+            sa.text("SELECT 1 FROM audit_logs WHERE resource_type='project_run_claim' LIMIT 1")
+        )
+        .first()
+    ):
+        raise RuntimeError("Retained claim audits prevent audit downgrade")
+    op.execute("DROP TRIGGER claim_audit_no_truncate ON audit_logs")
+    op.execute("DROP FUNCTION protect_claim_audit_truncate()")
+    op.execute("""CREATE OR REPLACE FUNCTION protect_project_run_claim_audit() RETURNS trigger AS $$
+      BEGIN
+        IF OLD.resource_type='project_run_claim' THEN
+          RAISE EXCEPTION 'project run claim audit is append-only';
+        END IF;
+        IF TG_OP='DELETE' THEN RETURN OLD; END IF;
+        RETURN NEW;
+      END; $$ LANGUAGE plpgsql""")
