diff --git a/src/cygnusx/application/services/archive_run_index_service.py b/src/cygnusx/application/services/archive_run_index_service.py
new file mode 100644
--- /dev/null
+++ b/src/cygnusx/application/services/archive_run_index_service.py
@@ -0,0 +1,403 @@
+"""Materialize archive metadata in the existing Run shell, only at explicit write/sync points."""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+from stat import S_ISREG
+from typing import Any
+from uuid import UUID
+
+from sqlalchemy import and_, or_, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from cygnusx.core.config import get_settings
+from cygnusx.core.exceptions import AuthorizationError, ConflictError, ValidationError
+from cygnusx.infrastructure.database.models.project import ProjectModel
+from cygnusx.infrastructure.database.models.run import RunModel
+from cygnusx.infrastructure.storage import get_path_factory
+from cygnusx.infrastructure.storage.path_factory import StoragePathFactory
+
+ARCHIVE_PARTS = ("README.md", "environment.json", "manifest.json")
+
+
+def archive_path(factory: StoragePathFactory, owner: UUID, slug: str, name: str) -> Path:
+    if (
+        not name
+        or len(name) > 255
+        or name.startswith(".")
+        or "/" in name
+        or "\\" in name
+        or any(ord(c) < 32 for c in name)
+    ):
+        raise ValidationError("只允许该项目内的单个 run 目录名", code="ARCHIVE_PATH_INVALID")
+    root = factory.user_root(str(owner))
+    path = factory.project_dir(str(owner), slug) / "runs" / name
+    try:
+        relative = path.relative_to(root)
+        current = root
+        if current.is_symlink():
+            raise ValueError("linked owner root")
+        for part in relative.parts:
+            current = current / part
+            if current.is_symlink():
+                raise ValueError("linked archive component")
+        path.resolve().relative_to(root.resolve())
+    except ValueError as exc:
+        raise AuthorizationError(
+            "归档目录不属于该项目物理空间", code="ARCHIVE_PATH_INVALID"
+        ) from exc
+    return path
+
+
+def read_archive_json(path: Path, owner_root: Path) -> tuple[dict[str, Any], str]:
+    from cygnusx.domain.dataset.validation import open_owned_file
+
+    limit = get_settings().research_manifest_max_bytes
+    with open_owned_file(path, owner_root) as stream:
+        before = os.fstat(stream.fileno())
+        payload = stream.read(limit + 1)
+        after = os.fstat(stream.fileno())
+    if len(payload) > limit:
+        raise ValidationError("归档清单超过校验预算", code="ARCHIVE_LIMIT")
+    if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
+        after.st_size,
+        after.st_mtime_ns,
+        after.st_ctime_ns,
+    ):
+        raise ConflictError("读取时归档发生变化", code="ARCHIVE_CHANGED")
+    try:
+        value = json.loads(payload)
+    except (ValueError, UnicodeError) as exc:
+        raise ValidationError("归档 JSON 无效", code="ARCHIVE_JSON_INVALID") from exc
+    if not isinstance(value, dict):
+        raise ValidationError("归档 JSON 必须是对象", code="ARCHIVE_JSON_INVALID")
+    return value, hashlib.sha256(payload).hexdigest()
+
+
+def inspect_archive(
+    factory: StoragePathFactory, owner: UUID, project: ProjectModel, name: str
+) -> dict[str, Any]:
+    path = archive_path(factory, owner, project.slug, name)
+    if not path.is_dir():
+        raise ValidationError("归档 run 目录不存在", code="ARCHIVE_MISSING")
+    stat = path.stat()
+    settings = get_settings()
+    count, size, activity = 0, 0, stat.st_mtime
+    truncated = False
+    deadline = time.monotonic() + settings.research_capture_timeout_seconds
+    for parent, dirs, files in os.walk(path, followlinks=False):
+        dirs[:] = [d for d in dirs if not (Path(parent) / d).is_symlink()]
+        activity = max(activity, Path(parent).stat().st_mtime)
+        for file in files:
+            candidate = Path(parent) / file
+            if candidate.is_symlink():
+                continue
+            item = candidate.stat()
+            if not S_ISREG(item.st_mode):
+                continue
+            count += 1
+            size += item.st_size
+            activity = max(activity, item.st_mtime)
+            if time.monotonic() > deadline:
+                truncated = True
+                break
+        if truncated:
+            break
+    metadata: dict[str, Any] = {
+        "has_readme": (path / "README.md").is_file() and not (path / "README.md").is_symlink(),
+        "has_environment": (path / "environment.json").is_file()
+        and not (path / "environment.json").is_symlink(),
+        "has_manifest": (path / "manifest.json").is_file()
+        and not (path / "manifest.json").is_symlink(),
+        "has_agents_md": (path / "AGENTS.md").is_file(),
+        "locations": [name],
+        "dirty": False,
+        "truncated": truncated,
+    }
+    manifest_hash = None
+    environment: dict[str, Any] = {}
+    for filename in ("environment.json", "manifest.json"):
+        if metadata["has_environment" if filename == "environment.json" else "has_manifest"]:
+            try:
+                value, sha = read_archive_json(path / filename, factory.user_root(str(owner)))
+                if filename == "manifest.json":
+                    manifest_hash = sha
+                else:
+                    environment = value
+            except ValidationError as exc:
+                metadata["error_code"] = exc.code
+    return {
+        "name": name,
+        "identity": f"{stat.st_dev}:{stat.st_ino}",
+        "manifest_hash": manifest_hash,
+        "file_count": count,
+        "total_bytes": size,
+        "last_activity": datetime.fromtimestamp(activity, UTC),
+        "metadata": metadata,
+        "environment": environment,
+    }
+
+
+class ArchiveRunIndexService:
+    def __init__(self, db: AsyncSession, factory: StoragePathFactory | None = None) -> None:
+        self.db = db
+        self.factory = factory or get_path_factory()
+
+    async def find(
+        self, owner: UUID, project_id: UUID, data: dict[str, Any], *, lock: bool = True
+    ) -> RunModel | None:
+        identities = [
+            RunModel.archive_identity == data["identity"],
+            and_(
+                RunModel.archive_directory == data["name"],
+                RunModel.archive_identity.is_(None),
+                RunModel.archive_manifest_sha256.is_(None),
+            ),
+        ]
+        if data.get("manifest_hash"):
+            identities.append(RunModel.archive_manifest_sha256 == data["manifest_hash"])
+        query = select(RunModel)
+        query = query.where(
+            RunModel.user_id == owner, RunModel.project_id == project_id, or_(*identities)
+        ).order_by(RunModel.created_at)
+        if lock:
+            query = query.with_for_update()
+        row = (await self.db.execute(query)).scalars().first()
+        if row is not None:
+            return row
+        # A pre-existing owned Task.work_dir is an explicit server reference.
+        # Use it only through an already bound Run; never adopt an orphan Task.
+        from cygnusx.infrastructure.database.models.task import TaskModel
+
+        project = await self.db.get(ProjectModel, project_id)
+        if project is None:
+            return None
+        expected = archive_path(self.factory, owner, project.slug, data["name"]).resolve()
+        candidates = (
+            await self.db.execute(
+                select(RunModel, TaskModel.work_dir)
+                .join(TaskModel, TaskModel.id == RunModel.task_id)
+                .where(
+                    RunModel.user_id == owner,
+                    RunModel.project_id == project_id,
+                    TaskModel.user_id == owner,
+                    RunModel.archive_directory.is_(None),
+                )
+            )
+        ).all()
+        matches: list[RunModel] = [
+            run
+            for run, work_dir in candidates
+            if isinstance(run, RunModel)
+            and work_dir
+            and Path(work_dir).parent.resolve() == expected
+        ]
+        if len(matches) > 1:
+            raise ConflictError("多个 Run 指向同一归档，请人工对账", code="RECONCILIATION_REQUIRED")
+        if not matches:
+            return None
+        if lock:
+            return (
+                await self.db.execute(
+                    select(RunModel)
+                    .where(RunModel.id == matches[0].id)
+                    .with_for_update()
+                    .execution_options(populate_existing=True)
+                )
+            ).scalar_one_or_none()
+        return matches[0]
+
+    async def put(
+        self,
+        owner: UUID,
+        project: ProjectModel,
+        data: dict[str, Any],
+        *,
+        run_id: UUID | None = None,
+    ) -> RunModel:
+        row = await self.find(owner, project.id, data)
+        if run_id is not None:
+            bound = await self.db.get(RunModel, run_id)
+            if (
+                bound is None
+                or bound.user_id != owner
+                or (bound.project_id is not None and bound.project_id != project.id)
+            ):
+                raise ConflictError("归档 Run 身份与项目不一致", code="RUN_PROJECT_MISMATCH")
+            if row is not None and row.id != bound.id:
+                raise ConflictError("归档已经绑定其他 Run", code="ARCHIVE_IDENTITY_CONFLICT")
+            row = bound
+        if row is None:
+            evidence = data.get("manifest_hash") or data["identity"]
+            run_environment = data["environment"].get("run")
+            flow = (
+                str(run_environment.get("analysis_type") or "historical_archive")[:100]
+                if isinstance(run_environment, dict)
+                else "historical_archive"
+            )
+            plan = {"name": data["name"], "operation": "archive.index", "execution_allowed": False}
+            row = RunModel(
+                user_id=owner,
+                project_id=project.id,
+                project_slug=project.slug,
+                flow_id=flow,
+                release_id="archive-v1",
+                request_key=f"archive:{project.id}:{evidence}",
+                plan_json=plan,
+                plan_digest=hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest(),
+                status="ARCHIVED_UNCLAIMED",
+            )
+            self.db.add(row)
+        if row.status == "HISTORICAL_CLAIMED" and row.archive_manifest_sha256 != data.get(
+            "manifest_hash"
+        ):
+            row.archive_present = True
+            row.archive_indexed_at = datetime.now(UTC)
+            row.archive_metadata = {
+                **row.archive_metadata,
+                "dirty": True,
+                "error_code": "CLAIMED_ARCHIVE_CHANGED",
+            }
+            await self.db.flush()
+            return row
+        locations = sorted(set((row.archive_metadata or {}).get("locations", []) + [data["name"]]))
+        row.project_id, row.project_slug = project.id, project.slug
+        row.archive_directory, row.archive_identity = data["name"], data["identity"]
+        row.archive_manifest_sha256, row.archive_present = data.get("manifest_hash"), True
+        row.archive_file_count, row.archive_total_bytes = data["file_count"], data["total_bytes"]
+        row.archive_last_activity, row.archive_indexed_at = data["last_activity"], datetime.now(UTC)
+        row.archive_metadata = {**data["metadata"], "locations": locations}
+        await self.db.flush()
+        return row
+
+    async def refresh(self, owner: UUID, project: ProjectModel) -> dict[str, Any]:
+        from time import perf_counter
+
+        started = perf_counter()
+        # Same lock order as claim: owned project, then its Run records.
+        await self.db.execute(
+            select(ProjectModel)
+            .where(ProjectModel.id == project.id, ProjectModel.user_id == owner)
+            .with_for_update()
+        )
+        rows = list(
+            (
+                await self.db.execute(
+                    select(RunModel).where(
+                        RunModel.user_id == owner,
+                        RunModel.project_id == project.id,
+                        RunModel.archive_directory.is_not(None),
+                    )
+                )
+            ).scalars()
+        )
+        for row in rows:
+            row.archive_present = False
+        runs = self.factory.project_dir(str(owner), project.slug) / "runs"
+        names = await asyncio.to_thread(
+            lambda: (
+                sorted(
+                    e.name
+                    for e in runs.iterdir()
+                    if e.is_dir() and not e.is_symlink() and not e.name.startswith(".")
+                )
+                if runs.is_dir() and not runs.is_symlink()
+                else []
+            )
+        )
+        errors = []
+        for name in names:
+            try:
+                data = await asyncio.to_thread(inspect_archive, self.factory, owner, project, name)
+                await self.put(owner, project, data)
+                if data["metadata"]["truncated"]:
+                    errors.append({"run_dir": name, "code": "ARCHIVE_INDEX_INCOMPLETE"})
+            except (OSError, ValidationError, AuthorizationError, ConflictError) as exc:
+                errors.append(
+                    {"run_dir": name, "code": getattr(exc, "code", "ARCHIVE_UNAVAILABLE")}
+                )
+        for row in rows:
+            if not row.archive_present:
+                row.archive_metadata = {
+                    **row.archive_metadata,
+                    "last_known_statistics": row.archive_metadata.get(
+                        "last_known_statistics",
+                        {
+                            "file_count": row.archive_file_count,
+                            "total_bytes": row.archive_total_bytes,
+                        },
+                    ),
+                    "has_readme": False,
+                    "has_environment": False,
+                    "has_manifest": False,
+                    "dirty": True,
+                    "error_code": "ARCHIVE_MISSING",
+                }
+                row.archive_file_count = 0
+                row.archive_total_bytes = 0
+                row.archive_indexed_at = datetime.now(UTC)
+        await self.db.flush()
+        return {
+            "project_id": str(project.id),
+            "directories": len(names),
+            "errors": errors,
+            "elapsed_ms": (perf_counter() - started) * 1000,
+        }
+
+
+async def index_written_archive(
+    owner: UUID,
+    slug: str,
+    run_dir: Path,
+    *,
+    db: AsyncSession | None = None,
+    run_id: UUID | None = None,
+    factory: StoragePathFactory | None = None,
+) -> None:
+    if db is None:
+        from cygnusx.infrastructure.database.session import get_session_factory
+
+        async with get_session_factory()() as session:
+            await index_written_archive(
+                owner, slug, run_dir, db=session, run_id=run_id, factory=factory
+            )
+            await session.commit()
+        return
+    project = (
+        await db.execute(
+            select(ProjectModel)
+            .where(ProjectModel.user_id == owner, ProjectModel.slug == slug)
+            .with_for_update()
+        )
+    ).scalar_one_or_none()
+    if project is None:
+        raise ConflictError("归档项目尚未登记，请显式同步", code="PROJECT_NOT_REGISTERED")
+    service = ArchiveRunIndexService(db, factory)
+    data = await asyncio.to_thread(inspect_archive, service.factory, owner, project, run_dir.name)
+    await service.put(owner, project, data, run_id=run_id)
+
+
+async def refresh_deleted_archive_path(db: AsyncSession, owner: UUID, path: str) -> None:
+    """Recompute existing project Run metadata after an authorized file/directory deletion."""
+    service = ArchiveRunIndexService(db)
+    owner_root = service.factory.user_root(str(owner))
+    candidate = Path(path)
+    if not candidate.is_absolute():
+        candidate = service.factory.data_root / candidate
+    try:
+        relative = candidate.relative_to(owner_root)
+    except ValueError:
+        return
+    projects = (
+        await db.execute(select(ProjectModel).where(ProjectModel.user_id == owner))
+    ).scalars()
+    for project in projects:
+        known = Path("projects") / project.slug / "runs"
+        if relative == known or relative in known.parents or known in relative.parents:
+            await service.refresh(owner, project)
