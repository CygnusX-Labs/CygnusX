+            phase="historical_claim",
+            payload={
+                "analysis_link_id": str(link.id),
+                "execution_allowed": False,
+                "attempt_number": run.attempt_number,
+            },
+        )
+        await self.db.flush()
+        return {
+            **self.existing_result(run),
+            "reused": False,
+            "handoff_hash": frozen["manifest_hash"],
+        }
+
+    async def approve(
+        self, owner: UUID, project_id: UUID, name: str, confirmation_id: UUID
+    ) -> dict[str, Any]:
+        await self.authorize(owner, project_id)
+        record = await self.confirmations.get_status(str(owner), str(confirmation_id))
+        if (
+            record is None
+            or record.tool_name != CLAIM_TOOL
