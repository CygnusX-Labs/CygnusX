new file mode 100644
--- /dev/null
+++ b/scripts/backfill_project_run_index.py
@@ -0,0 +1,71 @@
+"""Explicit, isolated-only Run metadata backfill; no Dataset claim or Task adoption."""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+from pathlib import Path
+from time import perf_counter
+
+from cygnusx.application.services.archive_run_index_service import ArchiveRunIndexService
+from cygnusx.core.config import get_settings
+from cygnusx.infrastructure.database.models.project import ProjectModel
+from cygnusx.infrastructure.database.session import get_session_factory
+from sqlalchemy import select
+from sqlalchemy.engine import make_url
+
+
+async def backfill(expected_database: str) -> list[dict[str, object]]:
+    if make_url(get_settings().database_url).database != expected_database:
+        raise ValueError("Database does not match the explicit isolated database name")
+    factory = get_session_factory()
+    async with factory() as db:
+        projects = [
+            (row.id, row.user_id) for row in (await db.execute(select(ProjectModel))).scalars()
+        ]
+    result: list[dict[str, object]] = []
+    for project_id, owner in projects:
+        started = perf_counter()
+        async with factory() as db:
+            try:
+                project = await db.get(ProjectModel, project_id)
+                if project is None:
+                    continue
+                entry = await ArchiveRunIndexService(db).refresh(owner, project)
+                await db.commit()
+                result.append(
+                    {
+                        **entry,
+                        "owner_id": str(owner),
+                        "status": "PARTIAL" if entry["errors"] else "INDEXED",
+                    }
+                )
+            except Exception as exc:
+                await db.rollback()
+                result.append(
+                    {
+                        "project_id": str(project_id),
+                        "owner_id": str(owner),
+                        "status": "FAILED",
+                        "code": getattr(exc, "code", type(exc).__name__),
+                        "elapsed_ms": (perf_counter() - started) * 1000,
+                    }
+                )
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--expected-database", required=True)
+    parser.add_argument("--confirm-isolated", action="store_true", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    rows = asyncio.run(backfill(args.expected_database))
+    args.output.write_text(json.dumps(rows, ensure_ascii=False, indent=2) + "\n")
+    if any(row["status"] != "INDEXED" for row in rows):
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
