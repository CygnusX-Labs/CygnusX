+async def test_unexpected_claim_failure_still_records_rejected_request() -> None:
+    from starlette.requests import Request
+
+    from cygnusx.middleware.audit import AuditMiddleware
+
+    middleware = AuditMiddleware(app=AsyncMock())
+    middleware._record = AsyncMock(return_value="audit-id")
+    request = Request(
+        {
+            "type": "http",
+            "method": "POST",
+            "path": "/api/v1/projects/p/runs/old/claim",
+            "headers": [],
+        }
+    )
+    with pytest.raises(RuntimeError, match="unexpected claim failure"):
+        await middleware.dispatch(
+            request, AsyncMock(side_effect=RuntimeError("unexpected claim failure"))
+        )
+    middleware._record.assert_awaited_once()
+    assert middleware._record.await_args.args[1].status_code == 500
