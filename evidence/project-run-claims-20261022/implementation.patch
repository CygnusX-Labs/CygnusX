+    project_model = await service.datasets.repo.project(owner, project)
+    await ArchiveRunIndexService(db).refresh(owner, project_model)
+    assert db.sync.scalar(select(func.count()).select_from(RunModel)) == 1
+    assert run.archive_directory == directory.name and run.task_id == task.id
+
+
+async def test_referenced_file_delete_is_rejected_before_storage_mutation(historical: Any) -> None:
+    from cygnusx.application.schemas.dataset import AssetAttach, DatasetCreate
+    from cygnusx.application.services.file_service import FileService
+
+    db, owner, _, project, _, path, service, file = historical
+    dataset = await service.datasets.create(owner, project, DatasetCreate(name="retained"))
+    version = db.sync.scalar(
+        select(DatasetVersionModel).where(DatasetVersionModel.dataset_id == dataset.id)
+    )
+    await service.datasets.attach_asset(
+        owner, project, dataset.id, version.id, AssetAttach(file_record_id=file.id, role="archive")
+    )
+    consumer = object.__new__(FileService)
+    consumer._session = db
+    consumer._files = SimpleNamespace(
+        get_visible=AsyncMock(return_value=SimpleNamespace(id=file.id))
+    )
+    consumer._require_delete_access = AsyncMock()
+    with pytest.raises(ConflictError, match="血缘"):
+        await consumer.delete_file(owner, file.id)
+    assert path.is_file()
+
+
+async def test_missing_directory_invalidates_totals_without_rewriting_frozen_evidence(
+    historical: Any,
+) -> None:
+    import shutil
+
+    db, owner, _, project, directory, _, service, _ = historical
+    request = RunClaimRequest(purpose="Retain historical evidence")
+    preview = await service.claim(owner, project, directory.name, request)
+    await service.approve(owner, project, directory.name, UUID(preview["confirmation_id"]))
+    result = await service.claim(
+        owner,
+        project,
+        directory.name,
+        request.model_copy(
+            update={"action": "commit", "confirmation_id": UUID(preview["confirmation_id"])}
+        ),
+    )
+    await db.commit()
+    version = await db.get(DatasetVersionModel, UUID(result["dataset_version_id"]))
+    frozen = version.handoff.copy()
+    row = db.sync.scalar(select(RunModel))
+    previous = row.archive_file_count
+    shutil.rmtree(directory)
+    project_model = await service.datasets.repo.project(owner, project)
+    await ArchiveRunIndexService(db).refresh(owner, project_model)
+    assert not row.archive_present
+    assert row.archive_file_count == row.archive_total_bytes == 0
+    assert not any(
+        row.archive_metadata[key] for key in ("has_readme", "has_environment", "has_manifest")
+    )
+    assert row.archive_metadata["last_known_statistics"]["file_count"] == previous
+    assert version.handoff == frozen
+    assert row.status == "HISTORICAL_CLAIMED"
+
