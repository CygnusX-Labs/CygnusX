+++ b/src/cygnusx/application/services/historical_run_claim_service.py
@@ -0,0 +1,520 @@
+"""Human-confirmed historical archive references; never submits or adopts a Task."""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import re
+from datetime import UTC, datetime
+from pathlib import Path, PurePosixPath
+from typing import Any
+from uuid import UUID
+
+from sqlalchemy import or_, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from cygnusx.application.schemas.dataset import AssetAttach, DatasetCreate, SampleAttach
+from cygnusx.application.schemas.run_claim import RunClaimRequest
+from cygnusx.application.services.archive_run_index_service import (
+    ArchiveRunIndexService,
+    archive_path,
+    inspect_archive,
+    read_archive_json,
+)
+from cygnusx.application.services.dataset_analysis_service import DatasetAnalysisService
+from cygnusx.application.services.dataset_handoff_service import DatasetHandoffService
+from cygnusx.application.services.dataset_import_service import require_dataset_read
+from cygnusx.application.services.dataset_service import DatasetService
+from cygnusx.application.services.project_service import ProjectService
+from cygnusx.application.services.tool_confirmation_service import get_tool_confirmation_service
+from cygnusx.core.config import get_settings
+from cygnusx.core.exceptions import AuthorizationError, ConflictError, ValidationError
+from cygnusx.domain.dataset.validation import ValidationLimits, checksum, open_owned_file
+from cygnusx.infrastructure.database.models.dataset import DatasetVersionModel
+from cygnusx.infrastructure.database.models.file import FileRecordModel
+from cygnusx.infrastructure.database.models.project import ProjectModel
+from cygnusx.infrastructure.database.models.run import RunModel
+
+CLAIM_TOOL = "project.run.claim"
+HISTORICAL = "HISTORICAL_CLAIMED"
+
+
+def verify_bytes(path: Path, root: Path) -> tuple[str, int]:
+    with open_owned_file(path, root) as stream:
+        before = os.fstat(stream.fileno())
+        result = checksum(
+            stream, ValidationLimits(max_bytes=get_settings().research_artifact_max_bytes)
+        )
+        after = os.fstat(stream.fileno())
+    if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
+        after.st_size,
+        after.st_mtime_ns,
+        after.st_ctime_ns,
+    ):
+        raise ConflictError("校验过程中归档文件改变", code="ARCHIVE_CHANGED")
+    return result
+
+
+def manifest_file(archive: Path, relative: str) -> Path:
+    parts = PurePosixPath(relative)
+    if (
+        not relative
+        or parts.is_absolute()
+        or parts.as_posix() != relative
+        or any(p in {"..", "."} for p in parts.parts)
+        or "\\" in relative
+        or any(ord(c) < 32 for c in relative)
+    ):
+        raise ValidationError("manifest 含非法文件引用", code="ARCHIVE_PATH_INVALID")
+    path = archive
+    for part in parts.parts:
+        path = path / part
+        if path.is_symlink():
+            raise AuthorizationError("归档文件不允许符号链接", code="ARCHIVE_PATH_INVALID")
+    try:
+        path.resolve().relative_to(archive.resolve())
+    except ValueError as exc:
+        raise AuthorizationError("manifest 文件越出归档空间", code="ARCHIVE_PATH_INVALID") from exc
+    return path
+
+
+class HistoricalRunClaimService:
+    def __init__(self, db: AsyncSession) -> None:
+        self.db = db
+        self.index = ArchiveRunIndexService(db)
+        self.datasets = DatasetService(db)
+        self.confirmations = get_tool_confirmation_service()
+
+    async def authorize(self, owner: UUID, project_id: UUID) -> ProjectModel:
+        project = await ProjectService(self.db).require_owner(owner, project_id)
+        for module in ("files", "tasks", "reports"):
+            await self.datasets.repo.require_module(owner, module)
+        require_dataset_read()
+        if project.status not in {None, "active", "completed", "handed_over"}:
+            raise AuthorizationError("该项目不可认领归档", code="PROJECT_INACTIVE")
+        return project
+
+    async def inspect(
+        self, owner: UUID, project: ProjectModel, name: str, request: RunClaimRequest
+    ) -> tuple[dict[str, Any], dict[str, Any], RunModel | None]:
+        factory = self.index.factory
+        data = await asyncio.to_thread(inspect_archive, factory, owner, project, name)
+        missing = [
+            filename
+            for filename, key in [
+                ("README.md", "has_readme"),
+                ("environment.json", "has_environment"),
+                ("manifest.json", "has_manifest"),
+            ]
+            if not data["metadata"][key]
+        ]
+        if missing:
+            raise ValidationError(
+                "归档三件套缺失：" + ", ".join(missing), code="ARCHIVE_INCOMPLETE"
+            )
+        if data["metadata"].get("truncated"):
+            raise ValidationError("归档超过校验预算", code="ARCHIVE_LIMIT")
+        archive = archive_path(factory, owner, project.slug, name)
+        manifest, manifest_sha = await asyncio.to_thread(
+            read_archive_json, archive / "manifest.json", factory.user_root(str(owner))
+        )
+        await asyncio.to_thread(
+            read_archive_json, archive / "environment.json", factory.user_root(str(owner))
+        )
+        if manifest_sha != data["manifest_hash"]:
+            raise ConflictError("归档清单改变，请重新预审", code="ARCHIVE_CHANGED")
+        files = manifest.get("files")
+        if not isinstance(files, list) or len(files) > get_settings().research_artifact_max_files:
+            raise ValidationError(
+                "manifest.files 必须为预算内的文件列表", code="ARCHIVE_MANIFEST_INVALID"
+            )
+        candidates = list(
+            (
+                await self.db.execute(
+                    select(RunModel)
+                    .where(
+                        RunModel.user_id == owner,
+                        or_(
+                            RunModel.archive_identity == data["identity"],
+                            RunModel.archive_manifest_sha256 == manifest_sha,
+                        ),
+                    )
+                    .order_by((RunModel.status == HISTORICAL).desc(), RunModel.created_at)
+                )
+            ).scalars()
+        )
+        existing = candidates[0] if candidates else None
+        if existing is not None and existing.status == HISTORICAL:
+            if existing.project_id != project.id:
+                raise ConflictError("该归档已属于其他项目的稳定 Run", code="CLAIM_PROJECT_MISMATCH")
+            if existing.archive_manifest_sha256 != manifest_sha:
+                raise ConflictError("已认领归档清单被改变", code="ARCHIVE_CHANGED")
+        elif existing is not None and existing.project_id != project.id:
+            existing = None
+        if existing is None:
+            existing = await self.index.find(owner, project.id, data, lock=False)
+        if (
+            existing is not None
+            and existing.status != HISTORICAL
+            and existing.plan_json.get("dataset_analysis_link_id")
+        ):
+            from cygnusx.infrastructure.database.models.dataset import DatasetAnalysisLinkModel
+
+            link = await self.db.get(
+                DatasetAnalysisLinkModel, UUID(existing.plan_json["dataset_analysis_link_id"])
+            )
+            raise ConflictError(
+                "该 Run 已有血缘或需要人工对账，不覆盖既有挂链",
+                code="RUN_ALREADY_LINKED" if link else "RECONCILIATION_REQUIRED",
+            )
+        if existing is not None and existing.task_id:
+            from cygnusx.infrastructure.database.models.task import TaskModel
+
+            task = await self.db.get(TaskModel, existing.task_id)
+            if task is None or task.user_id != owner:
+                raise ConflictError(
+                    "该 Run 的 Task 挂链缺失，请人工对账", code="RECONCILIATION_REQUIRED"
+                )
+        saved = (
+            (existing.plan_json.get("historical_claim") or {}).get("files", []) if existing else []
+        )
+        saved_map = {item["path"]: item for item in saved}
+        explicit = {item.manifest_path: item.file_record_id for item in request.files}
+        if len(explicit) != len(request.files):
+            raise ValidationError("显式文件映射重复", code="ARCHIVE_MAPPING_INVALID")
+        mapped: list[dict[str, Any]] = []
+        paths: set[str] = set()
+        refs: set[UUID] = set()
+        total = 0
+        for item in files:
+            if not isinstance(item, dict):
+                raise ValidationError("manifest 文件项无效", code="ARCHIVE_MANIFEST_INVALID")
+            relative, size, sha = item.get("path"), item.get("size"), item.get("sha256")
+            if (
+                not isinstance(relative, str)
+                or relative in paths
+                or type(size) is not int
+                or size < 0
+                or not isinstance(sha, str)
+                or re.fullmatch(r"[0-9a-fA-F]{64}", sha) is None
+            ):
+                raise ValidationError(
+                    "manifest 文件需唯一路径、大小及 SHA-256", code="ARCHIVE_MANIFEST_INVALID"
+                )
+            paths.add(relative)
+            total += size
+            if total > get_settings().research_artifact_max_bytes:
+                raise ValidationError("归档产物超过校验预算", code="ARCHIVE_LIMIT")
+            path = manifest_file(archive, relative)
+            if not path.is_file():
+                raise ValidationError(
+                    "manifest 登记文件不存在：" + relative, code="ARCHIVE_FILE_MISSING"
+                )
+            try:
+                actual = await asyncio.to_thread(verify_bytes, path, factory.user_root(str(owner)))
+            except OSError as exc:
+                raise ValidationError(
+                    "manifest 登记文件不存在：" + relative, code="ARCHIVE_FILE_MISSING"
+                ) from exc
+            if actual != (sha.lower(), size):
+                raise ConflictError(
+                    "归档文件大小或 SHA 不符：" + relative, code="ARCHIVE_FILE_CHANGED"
+                )
+            file_id = explicit.get(relative)
+            if file_id is None and relative in saved_map:
+                file_id = UUID(saved_map[relative]["file_record_id"])
+            if file_id is None:
+                rows = list(
+                    (
+                        await self.db.execute(
+                            select(FileRecordModel)
+                            .where(
+                                FileRecordModel.user_id == owner,
+                                FileRecordModel.storage_path
+                                == path.relative_to(factory.data_root).as_posix(),
+                                FileRecordModel.status == "active",
+                                FileRecordModel.lifecycle_status == "active",
+                            )
+                            .limit(2)
+                        )
+                    ).scalars()
+                )
+                if len(rows) != 1:
+                    raise ValidationError(
+                        "文件未唯一登记，请提供显式 FileRecord 映射：" + relative,
+                        code="FILE_REGISTRY_REFERENCE_REQUIRED",
+                    )
+                file_id = rows[0].id
+            record = await self.datasets.repo.file(owner, project.id, file_id)
+            if file_id in refs:
+                raise ValidationError(
+                    "同一 FileRecord 不能映射多个归档文件", code="ARCHIVE_MAPPING_INVALID"
+                )
+            refs.add(file_id)
+            if record.size != size or record.storage_backend != "local":
+                raise ConflictError(
+                    "FileRegistry 大小或存储后端不符", code="FILE_REGISTRY_MISMATCH"
+                )
+            if (
+                record.checksum
+                and len(record.checksum) == 64
+                and record.checksum.lower() != sha.lower()
+            ):
+                raise ConflictError("FileRegistry SHA 不符", code="FILE_REGISTRY_MISMATCH")
+            registered = factory.data_root / record.storage_path
+            if registered.exists():
+                if (
+                    await asyncio.to_thread(verify_bytes, registered, factory.user_root(str(owner)))
+                    != actual
+                ):
+                    raise ConflictError("登记源文件与归档不一致", code="FILE_REGISTRY_MISMATCH")
+            elif not (
+                existing
+                and existing.status == HISTORICAL
+                and saved_map.get(relative, {}).get("sha256") == sha.lower()
+            ):
+                raise ValidationError("FileRegistry 源文件不存在", code="FILE_REGISTRY_MISSING")
+            mapped.append(
+                {
+                    "path": relative,
+                    "file_record_id": str(file_id),
+                    "size": size,
+                    "sha256": sha.lower(),
+                    "integrity": "VERIFIED",
+                }
+            )
+        if not set(explicit).issubset(paths):
+            raise ValidationError("显式映射含 manifest 之外的文件", code="ARCHIVE_MAPPING_INVALID")
+        sample_ids, sample_keys = set(), set()
+        for sample in request.samples:
+            registered_sample = await self.datasets.repo.sample(owner, sample.sample_id)
+            if (
+                sample.sample_id in sample_ids
+                or sample.sample_key in sample_keys
+                or set(map(str, sample.file_record_ids)) != set(registered_sample.file_ids)
+                or not set(sample.file_record_ids).issubset(refs)
+            ):
+                raise ValidationError(
+                    "样本与已核对的显式文件映射不一致", code="ARCHIVE_MAPPING_INVALID"
+                )
+            sample_ids.add(sample.sample_id)
+            sample_keys.add(sample.sample_key)
+        bound = {
+            "operation": CLAIM_TOOL,
+            "owner_id": str(owner),
+            "project_id": str(project.id),
+            "run_dir": name,
+            "manifest_sha256": manifest_sha,
+            "archive_identity": data["identity"],
+            "purpose": request.purpose,
+            "files": sorted(mapped, key=lambda x: x["path"]),
+            "samples": [s.model_dump(mode="json") for s in request.samples],
+        }
+        return data, bound, existing
+
+    @staticmethod
+    def existing_result(run: RunModel) -> dict[str, Any]:
+        claim = run.plan_json["historical_claim"]
+        return {
+            "state": HISTORICAL,
+            "reused": True,
+            "run_id": str(run.id),
+            "dataset_id": claim["dataset_id"],
+            "dataset_version_id": claim["dataset_version_id"],
+            "analysis_link_id": run.plan_json["dataset_analysis_link_id"],
+            "task_id": None,
+            "worker_paths_verified": False,
+            "execution_allowed": False,
+            "purpose": claim["purpose"],
+        }
+
+    async def claim(
+        self, owner: UUID, project_id: UUID, name: str, request: RunClaimRequest
+    ) -> dict[str, Any]:
+        project = await self.authorize(owner, project_id)
+        if request.action == "commit":
+            await self.db.execute(
+                select(ProjectModel)
+                .where(ProjectModel.id == project_id, ProjectModel.user_id == owner)
+                .with_for_update()
+            )
+        data, bound, existing = await self.inspect(owner, project, name, request)
+        if existing is not None and existing.status == HISTORICAL:
+            # Same immutable evidence, including after rename/copy/move: retain identity.
+            await self.index.put(owner, project, data)
+            return self.existing_result(existing)
+        if request.action == "preview":
+            confirmation = await self.confirmations.create_for_tool(str(owner), CLAIM_TOOL, bound)
+            return {
+                "state": "PREVIEW",
+                "confirmation_id": confirmation.confirmation_id,
+                "parameters_hash": confirmation.parameter_hash,
+                "manifest_sha256": bound["manifest_sha256"],
+                "run_id": str(existing.id) if existing else None,
+                "files": bound["files"],
+                "purpose": request.purpose,
+                "integrity": "VERIFIED" if bound["files"] else "METADATA_ONLY",
+                "will_create": (["platform_runs metadata"] if existing is None else [])
+                + ["Dataset", "DatasetVersion", "frozen Handoff", "historical AnalysisLink"],
+                "existing_task_reference": str(existing.task_id)
+                if existing is not None and existing.task_id
+                else None,
+                "task_will_be_created": False,
+                "worker_paths_verified": False,
+                "execution_allowed": False,
+            }
+        if request.confirmation_id is None:
+            raise ValidationError(
+                "写入前必须预审并由 owner JWT 确认", code="CLAIM_CONFIRMATION_REQUIRED"
+            )
+        receipt = await self.confirmations.consume_tool_confirmation(
+            str(owner), str(request.confirmation_id), CLAIM_TOOL, bound
+        )
+        run = await self.index.put(owner, project, data)
+        dataset = await self.datasets.create(
+            owner, project.id, DatasetCreate(name=name[:200], description=request.purpose)
+        )
+        version = (
+            await self.db.execute(
+                select(DatasetVersionModel).where(
+                    DatasetVersionModel.dataset_id == dataset.id, DatasetVersionModel.number == 1
+                )
+            )
+        ).scalar_one()
+        claim = {
+            **bound,
+            "run_id": str(run.id),
+            "claimed_by": str(owner),
+            "claimed_at": datetime.now(UTC).isoformat(),
+            "approval_receipt": {
+                "confirmation_id": receipt.confirmation_id,
+                "parameters_hash": receipt.parameter_hash,
+                "status": receipt.status,
