+down_revision = "project_lifecycle01"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    op.add_column("platform_runs", sa.Column("project_id", postgresql.UUID(as_uuid=True)))
+    op.create_foreign_key(
+        "fk_platform_runs_project",
+        "platform_runs",
+        "projects",
+        ["project_id"],
+        ["id"],
+        ondelete="SET NULL",
+    )
+    op.execute("""UPDATE platform_runs AS r SET project_id=p.id FROM projects AS p
+                  WHERE r.user_id=p.user_id AND r.project_slug=p.slug""")
+    columns = [
