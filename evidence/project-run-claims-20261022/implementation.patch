--- /dev/null
+++ b/src/cygnusx/application/services/project_reconciliation_service.py
@@ -0,0 +1,224 @@
+"""Explicit read-only disk/Run/Link comparison; never repairs or adopts historical Tasks."""
+
+from __future__ import annotations
+
+import asyncio
+from contextlib import suppress
+from typing import Any
+from urllib.parse import quote
+from uuid import UUID
+
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from cygnusx.application.services.archive_run_index_service import (
+    ArchiveRunIndexService,
+    archive_path,
+    read_archive_json,
+)
+from cygnusx.application.services.dataset_service import DatasetService
+from cygnusx.application.services.project_service import ProjectService
+from cygnusx.core.exceptions import CygnusXError
+from cygnusx.infrastructure.database.models.dataset import (
+    DatasetAnalysisLinkModel,
+    DatasetModel,
+    DatasetVersionModel,
+)
+from cygnusx.infrastructure.database.models.run import RunModel
+from cygnusx.infrastructure.database.models.task import TaskModel
+
+
+class ProjectReconciliationService:
+    def __init__(self, db: AsyncSession) -> None:
+        self.db = db
+        self.index = ArchiveRunIndexService(db)
+
+    async def view(self, owner: UUID, project_id: UUID) -> dict[str, Any]:
+        project = await ProjectService(self.db).require_owner(owner, project_id)
+        for module in ("files", "tasks", "reports"):
+            await DatasetService(self.db).repo.require_module(owner, module)
+        factory = self.index.factory
+        probe = archive_path(factory, owner, project.slug, "reconciliation-probe")
+        root = probe.parent
+
+        def directories() -> list[dict[str, Any]]:
+            result: list[dict[str, Any]] = []
+            if not root.is_dir():
+                return result
+            for path in sorted(root.iterdir()):
+                if not path.is_dir() or path.is_symlink() or path.name.startswith("."):
+                    continue
+                stat = path.stat()
+                sha = None
+                with suppress(OSError, CygnusXError):
+                    _, sha = read_archive_json(
+                        path / "manifest.json", factory.user_root(str(owner))
+                    )
+                result.append(
+                    {
+                        "run_dir": path.name,
+                        "identity": f"{stat.st_dev}:{stat.st_ino}",
+                        "manifest_sha256": sha,
+                        "missing_parts": [
+                            name
+                            for name in ("README.md", "environment.json", "manifest.json")
+                            if not (path / name).is_file() or (path / name).is_symlink()
+                        ],
+                    }
+                )
+            return result
+
+        disk = await asyncio.to_thread(directories)
+        runs = list(
+            (
+                await self.db.execute(
+                    select(RunModel).where(
+                        RunModel.user_id == owner, RunModel.project_id == project_id
+                    )
+                )
+            ).scalars()
+        )
+        links = list(
+            (
+                await self.db.execute(
+                    select(DatasetAnalysisLinkModel)
+                    .join(
+                        DatasetVersionModel,
+                        DatasetVersionModel.id == DatasetAnalysisLinkModel.version_id,
+                    )
+                    .join(DatasetModel, DatasetModel.id == DatasetVersionModel.dataset_id)
+                    .where(DatasetModel.user_id == owner, DatasetModel.project_id == project_id)
+                )
+            ).scalars()
+        )
+        by_link = {str(link.id): link for link in links}
+        task_keys = {f"run:{run.id}" for run in runs} | {f"dataset:{link.id}" for link in links}
+        task_ids = {r.task_id for r in runs if r.task_id} | {
+            link.task_id for link in links if link.task_id
+        }
+        from sqlalchemy import or_
+
+        tasks = (
+            list(
+                (
+                    await self.db.execute(
+                        select(TaskModel).where(
+                            TaskModel.user_id == owner,
+                            or_(
+                                TaskModel.id.in_(task_ids), TaskModel.idempotency_key.in_(task_keys)
+                            ),
+                        )
+                    )
+                ).scalars()
+            )
+            if task_keys or task_ids
+            else []
+        )
+        by_task = {task.id: task for task in tasks}
+        by_key = {task.idempotency_key: task for task in tasks}
+        unclaimed = []
+        missing = []
+        bindings = []
+        physically_seen: set[UUID] = set()
+        for directory in disk:
+            matching = [
+                r
+                for r in runs
+                if r.archive_identity == directory["identity"]
+                or (
+                    directory["manifest_sha256"]
+                    and r.archive_manifest_sha256 == directory["manifest_sha256"]
+                )
+                or directory["run_dir"]
+                in (r.archive_metadata or {}).get("locations", [r.archive_directory])
+            ]
+            physically_seen.update(run.id for run in matching)
+            trusted = [
+                r for r in matching if str(r.plan_json.get("dataset_analysis_link_id")) in by_link
+            ]
+            if not trusted:
+                unclaimed.append(
+                    {
+                        "run_dir": directory["run_dir"],
+                        "missing_parts": directory["missing_parts"],
+                        "action": "REPAIR_ARCHIVE"
+                        if directory["missing_parts"]
+                        else "PREVIEW_CLAIM",
+                        "next_step": "补齐归档三件套后重新预审"
+                        if directory["missing_parts"]
+                        else "owner 提交用途声明与显式文件引用，预审并人工确认认领",
+                        "claim_endpoint": f"/projects/{project_id}/runs/{quote(directory['run_dir'], safe='')}/claim",
+                    }
+                )
+        for run in runs:
+            if run.archive_directory and run.id not in physically_seen:
+                missing.append(
+                    {
+                        "run_id": str(run.id),
+                        "run_dir": run.archive_directory,
+                        "action": "VERIFY_STORAGE_OR_RESTORE",
+                        "next_step": "核对挂载/备份及显式目录同步；不删除 Run 或重投 Task",
+                    }
+                )
+            lid = run.plan_json.get("dataset_analysis_link_id")
+            if lid and str(lid) not in by_link:
+                bindings.append(
+                    {
+                        "run_id": str(run.id),
+                        "analysis_link_id": str(lid),
+                        "reason": "RUN_LINK_MISSING",
+                    }
+                )
+            if run.task_id and run.task_id not in by_task:
+                bindings.append(
+                    {
+                        "run_id": str(run.id),
+                        "task_id": str(run.task_id),
+                        "reason": "RUN_TASK_MISSING",
+                    }
+                )
+            task = by_key.get(f"run:{run.id}")
+            if task and run.task_id != task.id:
+                bindings.append(
+                    {
+                        "run_id": str(run.id),
+                        "task_id": str(task.id),
+                        "reason": "RUN_TASK_BINDING_MISSING",
+                    }
+                )
+        for link in links:
+            owners = [
+                r for r in runs if r.plan_json.get("dataset_analysis_link_id") == str(link.id)
+            ]
+            if not owners:
+                bindings.append({"analysis_link_id": str(link.id), "reason": "LINK_RUN_MISSING"})
+            if link.state == "SUBMITTING" and link.task_id is None:
+                bindings.append(
+                    {"analysis_link_id": str(link.id), "reason": "SUBMITTING_UNRESOLVED"}
+                )
